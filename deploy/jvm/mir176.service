[Unit]
Description=Mir 1.76 multiplayer server (Scala, issue #1148)
After=network-online.target k3s.service
Wants=network-online.target

[Service]
User=mir176
Group=mir176
EnvironmentFile=/etc/mir176.env
# 类缓存（AppCDS，#1290）：开服从约 3.4 秒降到约 2.2 秒。缓存要用同一个 jar 跑一次生成（部署时试启动那次带
# -XX:ArchiveClassesAtExit，#1288）；文件不在或和 jar 对不上时 JVM 只打一行警告、照常不用缓存起服
ExecStart=/opt/mir176/jre/bin/java -Xms128m -Xmx1536m -Dfile.encoding=UTF-8 -XX:SharedArchiveFile=/opt/mir176/current/mir176.jsa -jar /opt/mir176/current/mir176.jar serve
# 停服时游戏线程把在线角色存档，给足时间
TimeoutStopSec=30
# JVM 收到 SIGTERM 正常退出时退出码是 143，不算失败
SuccessExitStatus=143
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mir176
PrivateTmp=true

[Install]
WantedBy=multi-user.target
