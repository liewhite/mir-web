{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "lib": ["ES2022", "DOM"], "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src", "test"]
}
