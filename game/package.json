{
  "name": "mir176-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2020,safari15 --sourcemap --outfile=../public/app.js",
    "check": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=/tmp/mir176-test --out-extension:.js=.mjs && node --test \"/tmp/mir176-test/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
